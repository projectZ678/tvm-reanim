-- Calculate optimal void height based on game environment
local function calculateSafeVoidY()
    local fallenHeight = Workspace.FallenPartsDestroyHeight
    if fallenHeight and fallenHeight > -50000 and fallenHeight < 0 then
        -- Keep parts 40 studs safely above Roblox's physics destroy limit
        return fallenHeight + 40
    end
    return -460
end

local function getTargetVoidCFrame()
    if State.mode == "SkyTrap" then
        return CFrame.new(0, 10000, 0)
    elseif State.mode == "Underground" then
        local baseCF = CFrame.new(0, 0, 0)
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                baseCF = hrp.CFrame
            end
        end
        return CFrame.new(baseCF.Position.X, baseCF.Position.Y - 120, baseCF.Position.Z)
    else
        -- Safe Void (Default)
        local voidY = State.customVoidY or calculateSafeVoidY()
        return CFrame.new(0, voidY, 0)
    end
end

