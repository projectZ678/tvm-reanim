local function cleanConnections()
    for _, conn in pairs(State.connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(State.connections)
end

local function restoreNormalState()
    cleanConnections()

    -- Remove global override flags
    if _G.hiddenBodyParts then
        _G.hiddenBodyParts["Head"] = nil
        _G.hiddenBodyParts["HumanoidRootPart"] = nil
    end
    if _G.hiddenBodyPartPositions then
        _G.hiddenBodyPartPositions["Head"] = nil
        _G.hiddenBodyPartPositions["HumanoidRootPart"] = nil
    end
    _G.hiddenBodyPartVoidY = nil

    -- Restore clone and real character head visibility
    local realChar, fakeChar = getActiveCharacters()
    if fakeChar and fakeChar.Parent then
        local fHead = fakeChar:FindFirstChild("Head")
        if fHead and fHead:IsA("BasePart") then
            fHead.Transparency = 0
            fHead.LocalTransparencyModifier = 0
            for _, d in ipairs(fHead:GetChildren()) do
                if d:IsA("Decal") then d.Transparency = 0 end
            end
        end
        for _, acc in ipairs(fakeChar:GetChildren()) do
            if acc:IsA("Accessory") then
                local h = acc:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    h.Transparency = 0
                    h.LocalTransparencyModifier = 0
                end
            end
        end
    end

    if realChar and realChar.Parent then
        local rHead = realChar:FindFirstChild("Head")
        if rHead and rHead:IsA("BasePart") then
            rHead.CanCollide = false
        end
    end
end

local function startEvadeMechanism()
    cleanConnections()

    local targetCF = getTargetVoidCFrame()
    local voidY = targetCF.Position.Y

    -- 1. Notify Zen/Unicorn Reanim synchronization
    _G.hiddenBodyParts = _G.hiddenBodyParts or {}
    _G.hiddenBodyParts["Head"] = true
    _G.hiddenBodyParts["HumanoidRootPart"] = true
    _G.hiddenBodyPartVoidY = voidY
    _G.hiddenBodyPartPositions = _G.hiddenBodyPartPositions or {}
    _G.hiddenBodyPartPositions["Head"] = targetCF
    _G.hiddenBodyPartPositions["HumanoidRootPart"] = targetCF

    -- 2. Stepped (PreSimulation): Strip collision and enforce neutral physics state
    State.connections.stepped = RunService.Stepped:Connect(function()
        if not State.enabled then return end
        local realChar, fakeChar = getActiveCharacters()
        if not (realChar and realChar.Parent) then return end

        local realHum = realChar:FindFirstChildOfClass("Humanoid")
        if realHum then
            pcall(function() realHum:ChangeState(Enum.HumanoidStateType.Physics) end)
        end

        local rHead = realChar:FindFirstChild("Head")
        local rHrp = realChar:FindFirstChild("HumanoidRootPart")

        local currentCF = getTargetVoidCFrame()

        if rHead and rHead:IsA("BasePart") then
            rHead.CanCollide = false
            rHead.CFrame = currentCF
        end

        if rHrp and rHrp:IsA("BasePart") then
            rHrp.CanCollide = false
            rHrp.CFrame = currentCF
        end

        -- Reposition attached head accessories to the void target
        for _, desc in ipairs(realChar:GetChildren()) do
            if desc:IsA("Accessory") then
                local h = desc:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    local att = h:FindFirstChildOfClass("Attachment")
                    local isHeadAcc = (att and (att.Name:find("Hat") or att.Name:find("Hair") or att.Name:find("Face") or att.Name:find("Head")))
                    if isHeadAcc then
                        h.CanCollide = false
                        h.CFrame = currentCF
                    end
                end
            end
        end
    end)

    -- 3. Heartbeat (PostSimulation): Zero out physics velocities so network owner replicates void lock
    State.connections.heartbeat = RunService.Heartbeat:Connect(function()
        if not State.enabled then return end
        local realChar, fakeChar = getActiveCharacters()
        if not (realChar and realChar.Parent) then return end

        local currentCF = getTargetVoidCFrame()
        local rHead = realChar:FindFirstChild("Head")
        local rHrp = realChar:FindFirstChild("HumanoidRootPart")

        if rHead and rHead:IsA("BasePart") then
            rHead.Anchored = false
            rHead.CanCollide = false
            rHead.CFrame = currentCF
            rHead.AssemblyLinearVelocity = Vector3.zero
            rHead.AssemblyAngularVelocity = Vector3.zero
        end

        if rHrp and rHrp:IsA("BasePart") then
            rHrp.Anchored = false
            rHrp.CanCollide = false
            rHrp.CFrame = currentCF
            rHrp.AssemblyLinearVelocity = Vector3.zero
            rHrp.AssemblyAngularVelocity = Vector3.zero
        end

        for _, desc in ipairs(realChar:GetChildren()) do
            if desc:IsA("Accessory") then
                local h = desc:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    local att = h:FindFirstChildOfClass("Attachment")
                    local isHeadAcc = (att and (att.Name:find("Hat") or att.Name:find("Hair") or att.Name:find("Face") or att.Name:find("Head")))
                    if isHeadAcc then
                        h.Anchored = false
                        h.CanCollide = false
                        h.CFrame = currentCF
                        h.AssemblyLinearVelocity = Vector3.zero
                        h.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end

        -- Attacker Interception Radar: Check if any player's root is within 25 studs of the void trap
        local trapPos = currentCF.Position
        local trappedCount = 0
        local lastTrappedName = nil

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                if pHrp then
                    local dist = (pHrp.Position - trapPos).Magnitude
                    if dist < 30 then
                        trappedCount = trappedCount + 1
                        lastTrappedName = p.DisplayName or p.Name
                    end
                end
            end
        end

        if trappedCount > 0 then
            valTrapped.Text = string.format("%d TRAPPED (%s)", trappedCount, lastTrappedName or "UNKNOWN")
            valTrapped.TextColor3 = C.red
        else
            valTrapped.Text = "0 (NONE)"
            valTrapped.TextColor3 = C.green
        end
    end)

    -- 4. RenderStepped (Visual Integrity): Keep your avatar looking 100% normal on the map
    State.connections.render = RunService.RenderStepped:Connect(function()
        if not State.enabled then return end
        local realChar, fakeChar = getActiveCharacters()

        if State.visualMirror and fakeChar and fakeChar.Parent and fakeChar ~= realChar then
            local fHead = fakeChar:FindFirstChild("Head")
            if fHead and fHead:IsA("BasePart") then
                fHead.Transparency = 0
                fHead.LocalTransparencyModifier = 0
                for _, d in ipairs(fHead:GetChildren()) do
                    if d:IsA("Decal") then d.Transparency = 0 end
                end
            end
            for _, acc in ipairs(fakeChar:GetChildren()) do
                if acc:IsA("Accessory") then
                    local h = acc:FindFirstChild("Handle")
                    if h and h:IsA("BasePart") then
                        h.Transparency = 0
                        h.LocalTransparencyModifier = 0
                    end
                end
            end
        end
    end)
end

