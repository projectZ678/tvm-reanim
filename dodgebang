local function getActiveCharacters()
    local realChar = nil
    local fakeChar = nil

    -- 1. Check Zen / Unicorn Reanimation globals
    if _G.ZenAPI and type(_G.ZenAPI.get_real_character) == "function" then
        realChar = _G.ZenAPI.get_real_character(LocalPlayer)
        fakeChar = _G.ZenAPI.get_clone and _G.ZenAPI.get_clone(LocalPlayer)
    elseif _G.ReanimateAPI and type(_G.ReanimateAPI.get_real_character) == "function" then
        realChar = _G.ReanimateAPI.get_real_character(LocalPlayer)
        fakeChar = _G.ReanimateAPI.get_clone and _G.ReanimateAPI.get_clone(LocalPlayer)
    end

    -- 2. Check internal Zen reanim tables if exposed
    if not realChar and _G.zen and _G.zen.real_chars then
        realChar = _G.zen.real_chars[LocalPlayer]
        fakeChar = _G.zen.clones and _G.zen.clones[LocalPlayer]
    end

    -- 3. Fallback to active Character
    if not realChar then
        realChar = LocalPlayer.Character
    end
    if not fakeChar then
        fakeChar = LocalPlayer.Character
    end

    return realChar, fakeChar
end

